{
	// Type checking only (npm run typecheck); bundling is done by esbuild (build.mjs)
	"compilerOptions": {
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2018",
		"lib": [
			"es2018",
			"dom"
		],
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false
	},
	"include": [
		"src"
	]
}
